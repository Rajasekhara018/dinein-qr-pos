# Copy to .env and fill in. Never commit .env.

# --- Public URL (used in table QR codes and payment redirects) -------------
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081
# Set to true when served over HTTPS (required in production).
APP_COOKIES_SECURE=false

# --- Database ----------------------------------------------------------------
POSTGRES_DB=dinein
POSTGRES_USER=dinein
POSTGRES_PASSWORD=change-me-db-password

# --- Secrets (each at least 32 random characters: `openssl rand -base64 48`) --
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
APP_GUEST_SESSION_SECRET=change-me-to-another-long-random-string-32-bytes

# --- First owner account (created only when no owner exists) ---------------
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=ChangeMe@123

# --- Payments: RAZORPAY | PAYU | PINELABS --------------------------------------
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_POST_SERVICE_URL=https://test.info.payu.in/merchant/postservice.php?form=2
PAYU_DEFAULT_EMAIL=orders@example.com

# --- Runtime profile: dev (seed data, Swagger) or prod ------------------------
SPRING_PROFILES_ACTIVE=prod
